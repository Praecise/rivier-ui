{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "paths": {
      "@/lib/*": ["./registry/lib/*"],
      "@/components/*": ["./registry/*"]
    }
  },
  "include": ["registry/**/*.ts", "registry/**/*.tsx", "scripts/**/*.ts"]
}
